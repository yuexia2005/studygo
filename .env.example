# ===========================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ===========================================

# 数据库密码（必填）
DB_PASSWORD=请修改为强密码

# 数据库名（默认 video_feed）
DB_NAME=video_feed

# JWT 密钥（必填，建议用 openssl rand -hex 32 生成）
JWT_SECRET=请修改为随机字符串

# 以下均有默认值，可按需修改
# DB_PORT=3306
# DB_USER=root
# REDIS_ADDR=redis:6379
# RABBITMQ_USER=admin
# RABBITMQ_PASS=password
# GIN_MODE=release
# CORS_ORIGIN=*  # 本地开发时放开跨域
